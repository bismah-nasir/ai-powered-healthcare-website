# PulseCare AI backend configuration
# Copy this file to .env (in this same backend/ folder) and fill in your own values:
#   cp .env.example .env
# Never commit .env; it holds real secrets.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
# Port the API listens on (optional, defaults to 5000).
# The frontend calls http://localhost:5000, so keep 5000 unless you change that too.
PORT=5000

# URL where the frontend runs. Used to build the password reset link in emails
# (optional, defaults to http://localhost:5173).
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# Database (REQUIRED - the server will not start without it)
# ---------------------------------------------------------------
# MongoDB Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>, <password> and add the database name before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ---------------------------------------------------------------
# Authentication (REQUIRED - the server will not start without it)
# ---------------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs every user out.
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------
# AI symptom checker (optional - the checker is disabled without a key)
# ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models to use (optional, these are the defaults)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------
# Email via Gmail (optional - used for password reset emails)
# ---------------------------------------------------------------
# Set ALL four SMTP_* values to send real email. If any is missing, emails go to
# a fake Ethereal inbox instead and a preview link is printed in the backend terminal.
#
# SMTP_PASS must be a Gmail App Password, not your normal Gmail password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces can be removed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=
# Sender address shown on emails. Gmail requires this to match SMTP_USER.
FROM_EMAIL=your-address@gmail.com
