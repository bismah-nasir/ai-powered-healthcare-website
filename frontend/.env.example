# PulseCare AI frontend configuration
# Copy this file to .env (in this same frontend/ folder) to change the defaults:
#   cp .env.example .env
# Vite reads it when the dev server starts or a build runs, so restart `npm run dev` after editing.

# Address of the backend server, without "/api" or a trailing slash
# (optional, defaults to http://localhost:5000).
# If you change the backend PORT, change this to match.
VITE_API_URL=http://localhost:5000
